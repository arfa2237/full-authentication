#: .\publicsite\templates\publicsite\blog1.html:179
#: .\publicsite\templates\publicsite\blog2.html:186
#: .\publicsite\templates\publicsite\blog3.html:181
msgid "About WHO"
msgstr "عالمی ادارہ صحت کے بارے میں"

#: .\publicsite\templates\publicsite\blog1.html:181
#: .\publicsite\templates\publicsite\blog2.html:188
#: .\publicsite\templates\publicsite\blog3.html:183
msgid ""
"Founded in 1948, WHO is the United Nations agency that connects nations, "
"partners and people to promote health, keep the world safe and serve the "
"vulnerable. We work with 194 Member States across more than 150 locations to "
"ensure everyone, everywhere, can attain the highest level of health. WHO has "
"been active in Pakistan since 1960. For more information, visit"
msgstr ""
"1948 میں قائم ہونے والا عالمی ادارہ صحت اقوام متحدہ کا وہ ادارہ ہے جو "
"صحت کو فروغ دینے، دنیا کو محفوظ رکھنے اور کمزور افراد کی خدمت کے لیے "
"قوموں، شراکت داروں اور لوگوں کو جوڑتا ہے۔ ہم 150 سے زائد مقامات میں 194 "
"رکن ممالک کے ساتھ کام کرتے ہیں تاکہ یقینی بنایا جا سکے کہ ہر جگہ ہر شخص "
"صحت کی بلند ترین سطح حاصل کر سکے۔ عالمی ادارہ صحت 1960 سے پاکستان میں "
"سرگرم ہے۔ مزید معلومات کے لیے ملاحظہ کریں"

